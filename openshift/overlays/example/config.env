# Keycloak realm the UI signs in with and the API trusts; the core service must reach it for the signing keys
KEYCLOAK_ISSUER_URI=https://keycloak.apps.hub.example.com/realms/openshift-portal
# Report schedules and alerts
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
OPENSHIFT_PORTAL_NOTIFICATIONS_FROM=openshift-portal@example.com
OPENSHIFT_PORTAL_NOTIFICATIONS_ALERTRECIPIENTS=platform-ops@example.com
OPENSHIFT_PORTAL_NOTIFICATIONS_PORTALURL=https://openshift-operations-portal.apps.hub.example.com
