# Copy to secrets.env (ignored by Git), fill in, then:
#   oc -n openshift-operations-portal create secret generic openshift-operations-portal-secrets --from-env-file=secrets.env
# The PostgreSQL and RabbitMQ components create their users from the same values.
SPRING_DATASOURCE_USERNAME=portal
SPRING_DATASOURCE_PASSWORD=
SPRING_RABBITMQ_USERNAME=portal
SPRING_RABBITMQ_PASSWORD=
# Leave empty for an SMTP relay without authentication (and set SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
