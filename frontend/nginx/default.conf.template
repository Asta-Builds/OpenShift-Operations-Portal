# Rendered by the image at start into /etc/nginx/conf.d/default.conf, inside the http block.
# ${PORTAL_API_URL} is the core service, e.g. http://openshift-operations-portal-core:8080

# Behind the OpenShift router TLS ends at the router: keep the scheme it saw
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    # Unprivileged port: the image runs under any UID (OpenShift restricted SCC)
    listen 8080;
    server_name _;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    root /usr/share/nginx/html;

    # The single-page app: unknown paths are Angular routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed bundles may be cached; index.html must not be, so a new release is picked up
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # The REST API on the same origin, so no CORS is needed
    location /api/v1/ {
        proxy_pass ${PORTAL_API_URL}/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        # Inventory CSV imports and node reports of large clusters
        client_max_body_size 10m;
    }

    # Probe of this container alone, independent of the backend
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
